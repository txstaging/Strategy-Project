# Copy to .env and change the values before deploying.

# Port the site is exposed on (http://<vps-ip>:APP_PORT)
APP_PORT=99

# Public URL of the site (used for JWT issuer/audience and BaseApiUrl)
PUBLIC_URL=http://your-domain-or-vps-ip

# PostgreSQL. Avoid ';' in the password, it breaks the connection string.
POSTGRES_DB=Mod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing key: long random string (at least 32 chars), e.g. `openssl rand -base64 48`
JWT_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
JWT_DAYS=7
